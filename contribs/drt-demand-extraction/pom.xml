<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<parent>
		<groupId>org.matsim</groupId>
		<artifactId>contrib</artifactId>
		<version>2026.0-SNAPSHOT</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.matsim.contrib</groupId>
	<artifactId>drt-demand-extraction</artifactId>
	<name>drt-demand-extraction</name>

	<dependencies>
		<dependency>
			<groupId>org.matsim</groupId>
			<artifactId>matsim</artifactId>
			<version>${project.parent.version}</version>
		</dependency>
		<dependency>
			<groupId>org.matsim.contrib</groupId>
			<artifactId>drt</artifactId>
			<version>${project.parent.version}</version>
		</dependency>
		<dependency>
			<groupId>org.matsim.contrib</groupId>
			<artifactId>dvrp</artifactId>
			<version>${project.parent.version}</version>
		</dependency>
		<dependency>
			<groupId>org.matsim.contrib</groupId>
			<artifactId>discrete_mode_choice</artifactId>
			<version>${project.parent.version}</version>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.matsim.contrib</groupId>
			<artifactId>vsp</artifactId>
			<version>${project.parent.version}</version>
		</dependency>
		<dependency>
			<groupId>org.matsim.contrib</groupId>
			<artifactId>application</artifactId>
			<version>${project.parent.version}</version>
		</dependency>
		<dependency>
			<groupId>org.eqasim</groupId>
			<artifactId>core</artifactId>
			<version>2.1.0</version>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.eqasim</groupId>
			<artifactId>bavaria</artifactId>
			<version>2.0.0</version>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.eqasim</groupId>
			<artifactId>ile_de_france</artifactId>
			<version>2.1.0</version>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-params</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<properties>
		<!-- JUnit 5 tag groups. Default: run everything except scenario-lyon and
		     regression (which need extra setup). Opt in with:
		         -Djunit.groups=scenario-lyon -Djunit.excludedGroups=
		         -Djunit.groups=regression    -Djunit.excludedGroups=
		     An empty <groups> value means "no group filter" (untagged tests run). -->
		<junit.groups></junit.groups>
		<junit.excludedGroups>scenario-lyon,regression</junit.excludedGroups>
		<surefire.jvm.args></surefire.jvm.args>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>**/legacy/**</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<groups>${junit.groups}</groups>
					<excludedGroups>${junit.excludedGroups}</excludedGroups>
					<argLine>${surefire.jvm.args}</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Activate with -Pscenario-lyon to run Lyon scenario tests with 100 GB heap,
		     R1 OOM profiling enabled, and checkpoint snapshots written to a fixed path.
		     Equivalent to manually passing:
		         -Djunit.groups=scenario-lyon -Djunit.excludedGroups=
		         -Xmx100g -DallowR1OomForProfiling=true -Dr1CheckpointCsv=<fixed path> -->
		<profile>
			<id>scenario-lyon</id>
			<properties>
				<junit.groups>scenario-lyon</junit.groups>
				<junit.excludedGroups></junit.excludedGroups>
				<surefire.jvm.args>-Xmx100g</surefire.jvm.args>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<systemPropertyVariables>
								<allowR1OomForProfiling>true</allowR1OomForProfiling>
								<r1CheckpointCsv>test/output/lyon-r1r2-fast-comparison/r1-progress.csv</r1CheckpointCsv>
							</systemPropertyVariables>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
